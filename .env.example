# ── AI 리포트 (둘 중 하나만 있으면 됩니다) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── 결제 (하나만 설정) ────────────────────────────────────────────
# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 포트원(아임포트) V2
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# Stripe (해외 결제)
STRIPE_SECRET_KEY=

# ── 운영 옵션 ────────────────────────────────────────────────────
# true 로 두면 orderId 없는 /api/reading 요청을 402로 막습니다.
REQUIRE_PAID_ORDER=false
# /api/reading 요청 검증용 공유 시크릿
REPORT_SECRET=
